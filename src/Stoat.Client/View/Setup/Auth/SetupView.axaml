<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Stoat.Client.ViewModel.Setup.Auth"
             xmlns:c="https://codewf.com"
             xmlns:lang="clr-namespace:Stoat.Client.I18n"
             Background="{DynamicResource Background}"
             x:DataType="vm:SetupViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="Stoat.Client.View.Setup.Auth.SetupView">
    <Panel>
        <Card HorizontalAlignment="Center" 
              Background="Transparent"
                      VerticalAlignment="Center"
                      MaxWidth="500"
                      Spacing="30">
            <Card.Header>
                <Svg Path="../../../Assets/logo.svg"
                      MaxWidth="220"
                      Margin="50, 20"
                      HorizontalAlignment="Center">
                    <Svg.Styles>
                        <Style Selector="Svg">
                            <Setter Property="(Svg.Css)" Value="{DynamicResource LogoSvgCss}" />
                        </Style>
                    </Svg.Styles>
                </Svg>
            </Card.Header>
            
            <StackPanel Spacing="20">
                <TextBlock Text="{c:I18n {x:Static lang:Lang.Title}}"
                           Classes="h2"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{c:I18n {x:Static lang:Lang.Description}}" 
                           TextAlignment="Center"
                           Classes="small muted"
                           TextWrapping="Wrap"/>
                
            </StackPanel>
            
            <Card.Footer>
                <StackPanel Spacing="20" Margin="50, 50, 50, 0">
                    <Button Classes="lg"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding  OpenLoginPageCommand}">
                        <TextBlock Foreground="{DynamicResource ForegroundAccent}" 
                                   Text="{c:I18n {x:Static lang:Lang.SignIn}}"/>
                    </Button>
                    
                    <Button Classes="lg secondary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenRegisterPageCommand}">
                        <TextBlock Text="{c:I18n {x:Static lang:Lang.SignUp}}"/>
                    </Button>
                    
                </StackPanel>
            </Card.Footer>
        </Card>
    </Panel>
</UserControl>
