<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="Foreground">#e3e1e9</SolidColorBrush>
    <SolidColorBrush x:Key="ForegroundMuted">#848389</SolidColorBrush>
    
    <SolidColorBrush x:Key="Background">#121318</SolidColorBrush>
    <SolidColorBrush x:Key="Surface">#1f1f25</SolidColorBrush>
    
    <SolidColorBrush x:Key="Primary">#505b92</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryHover">#4b5588</SolidColorBrush>
    
    
    
    <SolidColorBrush x:Key="Secondary">#424659</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryHover">#4f5264</SolidColorBrush>
    
    <SolidColorBrush x:Key="Link">#b9c3ff</SolidColorBrush>
    
    <system:String x:Key="LogoSvgCss">path { fill: #e3e1e9 }</system:String>
</ResourceDictionary>
