<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    <Design.PreviewWith>
        <Border Padding="20">
            <Card Width="200"
                        Height="200">
                
                <Card.Header>
                    <TextBlock HorizontalAlignment="Center" FontSize="20">Header</TextBlock>
                </Card.Header>
                
                <TextBlock HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           FontSize="20">Content</TextBlock>
                
                <Card.Footer>
                    <TextBlock HorizontalAlignment="Center" FontSize="20">Footer</TextBlock>
                </Card.Footer>
            </Card>
        </Border>
    </Design.PreviewWith>
    
    <ControlTheme x:Key="{x:Type Card}" 
                  TargetType="{x:Type Card}">
        
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Padding" Value="30"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Spacing" Value="10"/>
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="Auto * Auto" RowSpacing="{TemplateBinding Spacing}">
                        <Border Grid.Row="0">
                            <ContentPresenter Content="{TemplateBinding Header}"/>
                        </Border>
                        
                        <ContentPresenter Content="{TemplateBinding Content}" Grid.Row="1"/>
                        
                        <Border Grid.Row="2">
                            <ContentPresenter Content="{TemplateBinding Footer}"/>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
