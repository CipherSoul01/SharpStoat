<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lottie="clr-namespace:Avalonia.Labs.Lottie;assembly=Avalonia.Labs.Lottie"
        mc:Ignorable="d"
        x:Class="Stoat.Client.SplashWindow"
        WindowDecorations="None"
        Width="300"
        Height="350"
        Background="Transparent"
        Icon="/Assets/icon.ico"
        Title="SplashWindow">

    <Border Background="{DynamicResource Background}"
            CornerRadius="20">

        <Grid RowDefinitions="Auto, Auto"
              RowSpacing="50"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <lottie:Lottie Grid.Row="0"
                           Width="100"
                           Name="Logo"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Path="/Assets/icon-animation.json" />
            <Svg Grid.Row="0"
                 x:Name="HalloweenDecoration"
                 Path="./Assets/icon-halloween-decoration.svg"
                 IsVisible="False"
                 Width="100"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />

            <StackPanel Grid.Row="1"
                        Spacing="12"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center">

                <StoatSpinner Classes="primary dots"
                              Width="200"
                              Height="70"
                              Size="16"
                              HorizontalAlignment="Center" />
            </StackPanel>

        </Grid>
    </Border>
</Window>